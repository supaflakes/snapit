{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapit",
  "version": "0.5.1",
  "identifier": "com.snapit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNEUxNkY2MkMyOTBBMEUKUldRT0Npa3M5aFpPN2dRS3pSamUxTXBRenJqdjJYejJCUFpYTGFqZHF4S1kwVGM5N2MzS01MU1EK",
      "endpoints": [
        "https://github.com/supaflakes/snapit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
